# Publika värden. Anon/publishable-nyckeln är avsedd att ligga i klienten —
# skyddet ligger i RLS, inte i att nyckeln är hemlig.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Ligger ALDRIG här. Sätts som secrets i Supabase Edge Functions:
#   supabase secrets set CITYGROSS_STORE_NUMBER=3230
#
#   SUPABASE_SERVICE_ROLE_KEY   (sätts automatiskt av Supabase)
#   CITYGROSS_STORE_NUMBER      butiksnummer att synka, 3230 = Sundsvall
